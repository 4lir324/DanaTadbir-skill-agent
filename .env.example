# Copy to .env and fill in ONE key. Never commit .env.
#
# The provider is detected from the key you set, and each key is only ever sent to its own
# provider. Set LLM_PROVIDER (hetzner | groq) if you have both keys and want to choose.

# Groq free tier (RECOMMENDED: most stable in tests; Qwen3.8-27B; limit is 8K tokens/min)
GROQ_API_KEY=

# Hetzner Experiments Inference (free while experimental; timeouts seen, see README section 6)
# HETZNER_API_KEY=

# LLM_PROVIDER=groq

# --- Optional overrides (the provider preset already sets sensible values) -----------------
# LLM_MODEL=
# LLM_REQUESTS_PER_MINUTE=
# LLM_DISABLE_THINKING=true|false     # chat_template_kwargs: Hetzner accepts it, Groq rejects it
# LLM_STRUCTURED_OUTPUT=json_mode     # json_mode (default) | function_calling | json_schema
#                                     # (json_schema timed out on Hetzner, see README section 6)

# --- Any other OpenAI-compatible endpoint ---------------------------------------------------
# LLM_BASE_URL=https://example.com/v1
# LLM_MODEL=model-name
# LLM_API_KEY=
