# Copy to .env and fill in. Never commit .env.
# Default provider: Hetzner Experiments Inference (free while experimental, 10 req/min).
LLM_API_KEY=
LLM_BASE_URL=https://inference.hetzner.com/v1
LLM_MODEL=Qwen/Qwen3.8-27B

# Alternative: OpenRouter free model (<=35B)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_DISABLE_THINKING=false   # chat_template_kwargs is Qwen/vLLM specific

# Client-side throttle (requests per minute)
# LLM_REQUESTS_PER_MINUTE=9
