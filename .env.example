# Copy to .env and fill in. Never commit .env.
# Default provider: Hetzner Experiments Inference (free while experimental, 10 req/min).
LLM_API_KEY=
LLM_BASE_URL=https://inference.hetzner.com/v1
LLM_MODEL=Qwen/Qwen3.8-27B

# Alternative (tested, same 15/15 on our evaluation set): Groq free tier
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_DISABLE_THINKING=false        # Groq rejects chat_template_kwargs
# LLM_STRUCTURED_OUTPUT=json_mode   # Groq wraps json_schema output in an extra key
# LLM_REQUESTS_PER_MINUTE=10        # Groq's real limit is 8K tokens/min

# Client-side throttle (requests per minute)
# LLM_REQUESTS_PER_MINUTE=9
